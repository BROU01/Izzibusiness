# Copier en .env.local (jamais commité) puis renseigner les valeurs.
# Guide pas à pas : docs/neon.md

# --- Base de données Neon (Connect > chaîne « Pooled connection ») ---
# Serveur uniquement : ne jamais préfixer par NEXT_PUBLIC_
DATABASE_URL=

# --- Better Auth (sessions) ---
# Chaîne aléatoire d'au moins 32 caractères : `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# --- URL publique du site (liens e-mail, retours et IPN PayDunya) ---
# Ex. https://izzibusiness.com (sans / final). En local : http://localhost:3000
NEXT_PUBLIC_APP_URL=

# --- PayDunya (Intégrez notre API > votre application) ---
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# test = sandbox, live = vrais paiements (après validation KYC du compte)
PAYDUNYA_MODE=test
PAYDUNYA_STORE_NAME=Izzibusiness

# --- E-mails Resend (mot de passe oublié, notifications) ---
RESEND_API_KEY=
# Expéditeur d'un domaine vérifié chez Resend
EMAIL_FROM="Izzibusiness <no-reply@izzibusiness.com>"
